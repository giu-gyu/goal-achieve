rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(pairId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }
    function profileAfter(pairId) {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairId == pairId;
    }
    match /users/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, update, delete: if false;
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['pairId'])
        && request.resource.data.pairId is string
        && request.auth.uid in getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.members;
    }
    match /pairs/{pairId} {
      // The 128-bit invitation is a capability: direct reads only, never enumeration.
      allow get: if signedIn() && pairId.matches('^[0-9a-f]{32}$');
      allow list: if false;
      allow delete: if member(pairId);
      allow create: if signedIn() && pairId.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['members', 'names'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] is string
        && request.resource.data.names[request.auth.uid].size() >= 1
        && request.resource.data.names[request.auth.uid].size() <= 20
        && profileAfter(pairId);
      allow update: if member(pairId)
        || (signedIn()
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() == 1
        && request.resource.data.keys().hasOnly(['members', 'names'])
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names.keys().hasAll(request.resource.data.members)
        && request.resource.data.names.keys().size() == 2
        && request.resource.data.names[request.auth.uid] is string
        && request.resource.data.names[request.auth.uid].size() >= 1
        && request.resource.data.names[request.auth.uid].size() <= 20
        && profileAfter(pairId));
      // Both members have full access to every document in their shared space.
      match /{collection}/{document=**} {
        allow read, write: if member(pairId);
      }
    }
  }
}